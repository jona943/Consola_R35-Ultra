#!/bin/bash
. /etc/profile

# ==============================================================================
# 1. OPTIMIZACION DE KERNEL Y ENERGIA DINAMICA R35 ULTRA (2025/2026)
# ==============================================================================

# Desbloqueo termico: permitir hasta 85C antes de regular frecuencia
echo 85000 > /sys/class/thermal/thermal_zone0/trip_point_0_temp 2>/dev/null || true
echo 95000 > /sys/class/thermal/thermal_zone0/trip_point_1_temp 2>/dev/null || true

# CPU: Frecuencia dinamica de 408 MHz a 1.512 GHz con gobernador interactivo
echo 408000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 2>/dev/null || true
echo 1512000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || true
echo interactive > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo ondemand > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true

# GPU Mali-G31: Escalamiento por demanda de renderizado 3D (200 MHz a 520 MHz)
echo simple_ondemand > /sys/class/devfreq/ff400000.gpu/governor 2>/dev/null || echo dmc_ondemand > /sys/class/devfreq/ff400000.gpu/governor 2>/dev/null || true
echo 20 > /sys/class/devfreq/ff400000.gpu/polling_interval 2>/dev/null || true

# Controlador de Memoria DMC: Gobernador por demanda
echo dmc_ondemand > /sys/class/devfreq/dmc/governor 2>/dev/null || true

# Buffer de Lectura Anticipada (Read-Ahead) MicroSD y eMMC a 2048 KB (2 MB)
echo 2048 > /sys/block/mmcblk1/queue/read_ahead_kb 2>/dev/null || true
echo 2048 > /sys/block/mmcblk0/queue/read_ahead_kb 2>/dev/null || true

# Wi-Fi RK915: Habilitar ahorro de energia pasivo
iw dev wlan0 set power_save on 2>/dev/null || iwconfig wlan0 power on 2>/dev/null || true

# ==============================================================================
# 2. OPTIMIZACION DE MEMORIA RAM CON ZRAM (SWAP COMPRIMIDO EN RAM + VM TUNING)
# ==============================================================================
if [ -e /sys/block/zram0 ]; then
    swapoff /dev/zram0 2>/dev/null || true
    echo 1 > /sys/block/zram0/reset 2>/dev/null || true
    echo zstd > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lzo-rle > /sys/block/zram0/comp_algorithm 2>/dev/null || true
    echo 512M > /sys/block/zram0/disksize 2>/dev/null || true
    mkswap /dev/zram0 >/dev/null 2>&1 || true
    swapon -p 10 /dev/zram0 2>/dev/null || true

    # Optimizaciones de Memoria Virtual del Kernel para ZRAM y Bus LPDDR3
    echo 0 > /proc/sys/vm/page-cluster 2>/dev/null || true
    echo 60 > /proc/sys/vm/swappiness 2>/dev/null || true
    echo 50 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null || true
    echo 10 > /proc/sys/vm/dirty_ratio 2>/dev/null || true
    echo 5 > /proc/sys/vm/dirty_background_ratio 2>/dev/null || true
fi

# ==============================================================================
# 3. OVERRIDE DE WRAPPERS TURBO REAL-TIME (PPSSPP)
# ==============================================================================
if [ -f /storage/bin/ppsspp.sh ]; then
    mount --bind /storage/bin/ppsspp.sh /usr/bin/ppsspp.sh 2>/dev/null || true
fi

# ==============================================================================
# 4. INTEGRACION DE NUCLEOS RETROARCH Y ACCESO SSH
# ==============================================================================

# Vincular todos los nucleos de emuladores para RetroArch con alias
python3 -c "
import os, glob
for d in ['/storage/cores', '/tmp/cores']:
    os.makedirs(d, exist_ok=True)
    for f in glob.glob('/usr/lib/libretro/*'):
        base = os.path.basename(f)
        dst = os.path.join(d, base)
        if not os.path.exists(dst): os.symlink(f, dst)
        if base.endswith('_libretro.so'):
            alias = base[:-12] + '.so'
            alias_dst = os.path.join(d, alias)
            if not os.path.exists(alias_dst): os.symlink(f, alias_dst)
" 2>/dev/null || true

# ==============================================================================
# 5. HABILITACION PERMANENTE DE ACCESO SSH POR CONTRASENA (root:emuelec)
# ==============================================================================
mkdir -p /storage/.config/ssh /storage/.config/auth

# Desbloqueo y persistencia de sshd_config con PasswordAuthentication yes
if [ ! -f /storage/.config/ssh/sshd_config ]; then
    cp /etc/ssh/sshd_config /storage/.config/ssh/sshd_config
    sed -i "s/#PasswordAuthentication yes/PasswordAuthentication yes/g" /storage/.config/ssh/sshd_config
    sed -i "s/PasswordAuthentication no/PasswordAuthentication yes/g" /storage/.config/ssh/sshd_config
    sed -i "s/PermitRootLogin prohibit-password/PermitRootLogin yes/g" /storage/.config/ssh/sshd_config
    sed -i "s/#PermitRootLogin yes/PermitRootLogin yes/g" /storage/.config/ssh/sshd_config
fi
mount --bind /storage/.config/ssh/sshd_config /etc/ssh/sshd_config 2>/dev/null || true

# Inyeccion de contrasena 'emuelec' permanente en shadow
python3 -c "
import crypt
pwd_hash = crypt.crypt('emuelec', crypt.mksalt(crypt.METHOD_SHA512))
for path in ['/storage/.cache/shadow', '/storage/.config/auth/shadow']:
    try:
        with open(path, 'r') as f: lines = f.readlines()
        new_lines = [f'root:{pwd_hash}:19500:0:99999:7:::\n' if l.startswith('root:') else l for l in lines]
        with open(path, 'w') as f: f.writelines(new_lines)
    except Exception: pass
" 2>/dev/null || true

systemctl restart sshd 2>/dev/null || kill -HUP $(pidof sshd | head -n 1) 2>/dev/null || true

exit 0
