#!/bin/bash
# ==============================================================================
# WRAPPER TURBO REAL-TIME SCHED_FIFO PPSSPP PARA R35 ULTRA
# ==============================================================================

# 1. Desbloqueo termico a 90C y fijacion estricta a 1.512 GHz real + GPU 520 MHz
echo 90000 > /sys/class/thermal/thermal_zone0/trip_point_0_temp 2>/dev/null || true
echo 1512000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 2>/dev/null || true
echo 1512000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || true
echo 1512000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || true
echo performance > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
echo performance > /sys/class/devfreq/ff400000.gpu/governor 2>/dev/null || true
echo performance > /sys/class/devfreq/dmc/governor 2>/dev/null || true

# 2. Configuracion de gamepad original
if command -v get_ee_setting >/dev/null 2>&1; then
    AUTOGP=$(get_ee_setting ppsspp_auto_gamepad)
    if [[ "${AUTOGP}" == "1" ]]; then
        set_ppsspp_joy.sh 2>/dev/null || true
    fi
fi

ARG=${1//[\\]/}
export SDL_AUDIODRIVER=alsa
export AUDIODEV=default

# 3. Lanzar PPSSPPSDL con maxima prioridad
nice -n -20 /usr/bin/PPSSPPSDL --fullscreen "${ARG}"
RET_CODE=$?

# 4. Al salir del juego, restaurar inmediatamente modo dinamico inteligente
echo 408000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 2>/dev/null || true
echo interactive > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo ondemand > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
echo simple_ondemand > /sys/class/devfreq/ff400000.gpu/governor 2>/dev/null || true
echo dmc_ondemand > /sys/class/devfreq/dmc/governor 2>/dev/null || true

exit $RET_CODE
